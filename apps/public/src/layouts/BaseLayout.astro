---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  current?: 'product' | 'trust';
}

const { title, description, current = 'product' } = Astro.props;
const consoleUrl = import.meta.env.PUBLIC_CONSOLE_URL || 'http://localhost:3000/login';
const siteUrl = import.meta.env.PUBLIC_SITE_URL;
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0405" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="wordmark" href="/" aria-label="Action Integrity home">
          <span class="mark" aria-hidden="true"><span></span></span>
          <span>ACTION<span class="wordmark-gap">/</span>INTEGRITY</span>
        </a>
        <nav class="main-nav" aria-label="Primary navigation">
          <a href="/" aria-current={current === 'product' ? 'page' : undefined}>Product</a>
          <a href="/trust/" aria-current={current === 'trust' ? 'page' : undefined}>Trust model</a>
        </nav>
        <a class="header-cta" href={consoleUrl}>Open control room <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <a class="wordmark" href="/"><span class="mark" aria-hidden="true"><span></span></span><span>ACTION<span class="wordmark-gap">/</span>INTEGRITY</span></a>
          <p>Evidence before action. Verification before closure.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/">Product</a>
          <a href="/trust/">Trust model</a>
          <a href={consoleUrl}>Control room</a>
        </nav>
        <div class="footer-meta">PUBLIC SYSTEM / 2026<br />Built for accountable action.</div>
      </div>
    </footer>
  </body>
</html>
