{
  "name": "action-integrity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "npm run check:routes",
    "dev": "next dev --webpack",
    "prebuild": "npm run check:routes",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test:unit": "node scripts/run-unit.mjs",
    "test:integration": "node scripts/run-integration.mjs",
    "test:http": "node --env-file-if-exists=.env --import tsx src/test/integration/http-smoke.test.ts",
    "test:integrity-http": "node --conditions=react-server --env-file-if-exists=.env --import tsx src/test/integration/integrity-http.test.ts",
    "test:phase4-http": "node --conditions=react-server --env-file-if-exists=.env --import tsx src/test/integration/phase4-http.test.ts",
    "test:phase5-http": "node --conditions=react-server --env-file-if-exists=.env --import tsx src/test/integration/phase5-http.test.ts",
    "test:db": "node --conditions=react-server --env-file-if-exists=.env --import tsx src/test/db/integrity.test.ts",
    "test:rbac": "node --conditions=react-server --env-file-if-exists=.env --import tsx src/test/integration/rbac.test.ts",
    "test:envelope": "vitest run src/test/envelope",
    "test:failure": "tsx scripts/not-implemented.ts 'Phase 12 implements failure tests'",
    "test:adversarial": "tsx scripts/not-implemented.ts 'Phase 9 implements adversarial tests'",
    "test:scenarios": "node --conditions=react-server --env-file-if-exists=.env --import tsx src/test/scenarios/phase4.ts",
    "test:load": "tsx scripts/not-implemented.ts 'Phase 12 implements load tests'",
    "test:chaos": "tsx scripts/not-implemented.ts 'Phase 12 implements chaos tests'",
    "test:e2e": "tsx scripts/not-implemented.ts 'Phase 8 implements end-to-end tests'",
    "test:all": "npm run typecheck && npm run lint && npm run test:unit",
    "seed": "node --conditions=react-server --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "seed:reset": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/seed-reset.ts",
    "seed:scenario": "tsx scripts/not-implemented.ts 'Phase 2 implements scenario seeding'",
    "demo:reset": "tsx scripts/not-implemented.ts 'Phase 13 implements demo reset'",
    "demo:scenario": "tsx scripts/not-implemented.ts 'Phase 13 implements demo scenarios'",
    "reconcile:executions": "tsx scripts/not-implemented.ts 'Phase 11 implements reconciliation'",
    "audit:verify": "tsx scripts/not-implemented.ts 'Phase 10 implements audit verification'",
    "readiness": "tsx scripts/not-implemented.ts 'Phase 13 implements readiness checks'",
    "drill:restore": "tsx scripts/not-implemented.ts 'Phase 12 implements restore drills'",
    "smoke": "tsx scripts/not-implemented.ts 'Phase 13 implements deployment smoke tests'",
    "check:secrets-scope": "tsx scripts/check-secrets-scope.ts",
    "check:routes": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/check-route-coverage.ts",
    "policy:hash": "tsx scripts/policy-hash.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/archivo": "5.2.8",
    "@fontsource/space-mono": "5.2.8",
    "@google/genai": "2.31.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "ioredis": "6.0.0",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/nextjs-vite": "10.6.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "storybook": "10.6.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
